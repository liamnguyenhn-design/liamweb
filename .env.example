# SMTP configuration for the Node.js contact form API route (app/api/contact/route.ts)
# Any SMTP provider works: Gmail App Password, Zoho, SendGrid SMTP, Amazon SES SMTP, Hostinger email, etc.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password

# Where contact-form messages should be delivered
CONTACT_TO_EMAIL=liamnguyen.hn@gmail.com

# Public site URL, used for metadata/Open Graph tags
NEXT_PUBLIC_SITE_URL=https://your-domain.com
